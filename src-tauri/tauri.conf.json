{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ToS Checker",
  "version": "0.1.0",
  "identifier": "com.toschecker.desktop",
  "build": {
    "frontendDist": "../dist/app",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run build && npm run serve",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ToS Checker",
        "width": 1100,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
